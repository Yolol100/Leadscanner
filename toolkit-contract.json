{
  "schema_version": "2.0",
  "owner_skill": "leads",
  "project_id": "project-leads",
  "repository": "Yolol100/Leadscanner",
  "repository_role": "central_leads_github_runtime",
  "requires_mcp": false,
  "capabilities": {
    "prospect_discovery": {
      "workflow": ".github/workflows/prospect-discovery.yml",
      "requires_account": true,
      "required_secrets": ["GOOGLE_SERVICE_ACCOUNT_JSON"],
      "forbidden_secrets": ["OUTREACH_MAIL_PASSWORD", "OUTREACH_MAILBOXES_JSON", "REOON_API_KEY"],
      "modes": ["validate", "bootstrap", "discover"],
      "outputs": ["ProspectCandidates", "prospect-discovery-report.json"],
      "send_permission": "none"
    },
    "website_evidence_scan": {
      "workflow": ".github/workflows/scan.yml",
      "requires_account": false,
      "requires_api_key": false,
      "read_only": true,
      "normal_default_for_every_prospect": false,
      "outputs": ["scan-results/", "scan-results/leads-handoff.json"]
    },
    "outreach_delivery": {
      "workflow": ".github/workflows/outreach-smtp.yml",
      "requires_account": true,
      "required_secrets": ["GOOGLE_SERVICE_ACCOUNT_JSON", "OUTREACH_MAIL_PASSWORD"],
      "optional_secrets": ["OUTREACH_MAILBOXES_JSON"],
      "forbidden_secrets": ["REOON_API_KEY"],
      "modes": ["validate", "live"],
      "manual_default": "validate",
      "external_email_verifier": "none_required_for_active_direct_smtp_route",
      "outputs": ["OutreachQueue", "OutreachSequences", "ReplyInbox", "Suppression", "OutreachLog", "VariantAnalytics", "MailboxHealth"]
    }
  },
  "scanner_tools": [
    {"id":"crawlee","version":"3.18.0","trigger_when":"explicit website audit or Leads technical evidence-gap crawl orchestration is needed","outputs":["scan-results/"]},
    {"id":"playwright","version":"1.62.1","trigger_when":"explicit audit or Leads technical evidence-gap desktop/mobile browser evidence is needed","outputs":["scan-results/"]},
    {"id":"axe-core","version":"4.13.0","trigger_when":"homepage audit evidence is collected","outputs":["finding_candidates"]},
    {"id":"linkinator","version":"8.0.3","trigger_when":"supplemental link signals are needed for the scoped evidence question","outputs":["supplemental signals"]},
    {"id":"lighthouse","version":"13.4.1","trigger_when":"performance context is the scoped evidence question","outputs":["supplemental signals"]},
    {"id":"languagetool","version":"pinned-local-script","trigger_when":"Dutch language signals are requested","outputs":["supplemental signals"]},
    {"id":"sitemap-robots","version":"repo","trigger_when":"route discovery is needed","outputs":["route discovery"]},
    {"id":"tech-detect","version":"repo","trigger_when":"technology context is necessary to interpret the scoped evidence question","outputs":["context"]},
    {"id":"leads-handoff","version":"repo","trigger_when":"a completed explicit audit or evidence-gap scan returns to Leads","outputs":["scan-results/leads-handoff.json"]}
  ],
  "usage_assertions": [
    {"tool":"crawlee","path":"package.json","contains":"\"crawlee\""},
    {"tool":"playwright","path":"package.json","contains":"\"playwright\""},
    {"tool":"axe-core","path":"src/scan.mjs","contains":"AxeBuilder"},
    {"tool":"linkinator","path":"package.json","contains":"\"linkinator\""},
    {"tool":"lighthouse","path":"package.json","contains":"\"lighthouse\""},
    {"tool":"languagetool","path":".github/workflows/scan.yml","contains":"start-languagetool.sh"},
    {"tool":"sitemap-robots","path":"src/scan.mjs","contains":"discoverSite"},
    {"tool":"tech-detect","path":".github/workflows/scan.yml","contains":"RUN_TECH_DETECT"},
    {"tool":"leads-handoff","path":"package.json","contains":"handoff:leads"}
  ],
  "boundaries": [
    "The website scanner remains read-only and optional; it never changes lead fit, priority, compliance, send permission or outreach state.",
    "Prospect discovery finds approved-source company/domain candidates only and receives no mail credentials.",
    "Lead qualification, contact choice, compliance and copy remain owned by Leads, not by the repository runtime.",
    "The active direct SMTP route requires no Reoon dependency; legacy verification columns remain transport-compatible only.",
    "Live outreach is fail-closed and is never executed by CI.",
    "Reply, bounce and opt-out readback stop follow-up state and maintain suppression evidence.",
    "No secret value belongs in repository files, logs, test fixtures or artifacts."
  ]
}
