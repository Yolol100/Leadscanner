{
  "version": "3.0",
  "repository_role": "central_leads_github_runtime",
  "policy": {
    "website_scanner_read_only": true,
    "prospect_discovery_bounded": true,
    "outreach_live_fail_closed": true,
    "changes_lead_fit_automatically": false,
    "changes_compliance_automatically": false,
    "generates_mailcopy": false,
    "required_scanner_output": "scan-results/leads-handoff.json",
    "never_simulate_browser_evidence": true
  },
  "capabilities": {
    "prospect_discovery": {
      "workflow": ".github/workflows/prospect-discovery.yml",
      "runtime": "python",
      "role": "bounded_company_domain_discovery",
      "modes": ["validate", "bootstrap", "discover"],
      "writes": ["ProspectCandidates"],
      "boundaries": [
        "approved ProspectSources only",
        "no contact harvesting",
        "no lead score or qualification decision",
        "no mail copy",
        "no SMTP/IMAP credentials",
        "no send permission"
      ]
    },
    "website_evidence_scan": {
      "workflow": ".github/workflows/scan.yml",
      "runtime": "node",
      "role": "optional_readonly_website_audit_capability",
      "read_only": true,
      "normal_default_for_every_prospect": false,
      "output": "scan-results/leads-handoff.json",
      "safe_boundary": "GET/HEAD only; no submit/order/payment/booking confirmation"
    },
    "outreach_delivery": {
      "workflow": ".github/workflows/outreach-smtp.yml",
      "runtime": "python",
      "role": "controlled_transport_for_preapproved_leads_state",
      "modes": ["validate", "live"],
      "manual_default": "validate",
      "transport": "direct mijn.host SMTP + IMAP readback",
      "external_email_verifier_required": false,
      "boundaries": [
        "Leads owns qualification/contact/compliance/copy",
        "compliance preflight runs before SMTP",
        "reply/bounce/opt-out stop sequences fail-closed",
        "suppression checked before send",
        "scheduled live requires explicit OUTREACH_ENABLED=true",
        "no live send from CI"
      ]
    }
  },
  "scanner_routing": {
    "why_it_exists": "Levert reproduceerbaar desktop/mobile browserbewijs voor expliciete audits of een specifiek technisch bewijs-gat dat Leads na de lichte officiële-sitecheck heeft vastgesteld.",
    "use_when": [
      "de gebruiker expliciet een website-audit vraagt",
      "de gebruiker expliciet een technische scan of rescan vraagt",
      "Leads heeft een specifiek technisch bewijs-gat dat niet eenvoudiger bewezen kan worden"
    ],
    "do_not_use_for": [
      "prospect discovery",
      "contactinformatie zoeken",
      "compliance bepalen",
      "leadscore bepalen",
      "mailcopy genereren",
      "SMTP/IMAP transport"
    ]
  },
  "tools": {
    "crawlee": {"status":"existing","purpose":"bounded crawl orchestration","evidence_role":"orchestration_only"},
    "playwright": {"status":"existing","purpose":"desktop/mobile browser evidence","evidence_role":"primary_browser_evidence"},
    "axe_core": {"status":"enabled","purpose":"automated accessibility candidate signals","evidence_role":"supplemental_candidate_signal","automatic_score_effect":false},
    "sitemap_robots": {"status":"enabled","purpose":"route discovery and access policy","evidence_role":"route_discovery_support"},
    "linkinator": {"status":"enabled","purpose":"shallow same-origin link checks","evidence_role":"supplemental_candidate_signal"},
    "lighthouse": {"status":"existing_optional","purpose":"optional performance/accessibility/best-practices/SEO context","evidence_role":"supplemental_candidate_signal"},
    "languagetool": {"status":"optional_local","purpose":"optional Dutch language signals","evidence_role":"supplemental_candidate_signal"},
    "tech_detect": {"status":"enabled","purpose":"technology context for audit interpretation","evidence_role":"context_only"},
    "leads_handoff": {"status":"enabled","purpose":"normalize audit evidence for Leads readback","evidence_role":"handoff_adapter"},
    "prospect_discovery": {"status":"enabled","purpose":"bounded approved-source company/domain discovery","evidence_role":"lead_candidate_discovery"},
    "outreach_transport": {"status":"enabled","purpose":"preflight, SMTP/IMAP, sequences, suppression and reporting","evidence_role":"transport_readback"}
  }
}
