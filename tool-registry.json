{
  "version": "3.6",
  "repository_role": "central_leads_github_runtime",
  "policy": {
    "website_scanner_read_only": true,
    "prospect_discovery_bounded": true,
    "prospect_target_policy_enforced": true,
    "prospect_intelligence_advisory_only": true,
    "prospect_signal_discovery_advisory_only": true,
    "contact_enrichment_qualified_only": true,
    "sender_readiness_diagnostic_only": true,
    "inbox_placement_seed_only": true,
    "mailbox_draft_imap_only": true,
    "dashboard_readout_only": true,
    "outreach_live_fail_closed": true,
    "outreach_requires_website_scan_evidence": true,
    "changes_lead_fit_automatically": false,
    "changes_compliance_automatically": false,
    "generates_mailcopy": false,
    "required_scanner_output": "scan-results/leads-handoff.json",
    "never_simulate_browser_evidence": true
  },
  "capabilities": {
    "prospect_discovery": {
      "workflow": ".github/workflows/prospect-discovery.yml",
      "runtime": "python",
      "role": "bounded_international_company_domain_discovery_with_target_fill_and_source_run_evidence",
      "modes": ["validate", "bootstrap", "discover"],
      "source_types": ["seed_site", "directory_page", "directory_index", "directory_sitemap"],
      "writes": ["ProspectCandidates", "ProspectObservations", "ProspectSourceRuns"],
      "boundaries": ["approved ProspectSources only", "NL excluded by default", "US prioritized before configured non-NL European sources", "web/design/development/marketing/advertising/SEO/branding/digital/commerce agencies excluded by default", "bounded target-fill only", "target gaps are reported honestly", "directory_sitemap follows at most 3 same-host sitemap-index children", "external sitemap-index children are ignored", "XML remains byte/timeout/robots/public-network bounded", "source-run history is evidence only", "observations are provenance/freshness only", "no contact harvesting", "no lead score or qualification decision", "no mail copy", "no SMTP/IMAP credentials", "no send permission"]
    },
    "prospect_intelligence": {
      "workflow": ".github/workflows/prospect-intelligence.yml",
      "runtime": "python",
      "role": "derived_entity_freshness_signal_source_economics_and_lookalike_intelligence",
      "modes": ["validate", "bootstrap", "refresh"],
      "reads": ["ProspectSources", "ProspectCandidates", "ProspectObservations", "ProspectSignals", "ContactCandidates", "Leadlijst"],
      "writes": ["ProspectEntities", "ProspectSourceMetrics", "ProspectEvidence", "ProspectLookalikes"],
      "boundaries": ["signals require evidence-bound candidate IDs", "derived/advisory only", "no Customer Potential mutation", "no compliance mutation", "no contact promotion", "no mail copy", "no SMTP/IMAP credentials", "no send permission"]
    },
    "prospect_signal_discovery": {
      "workflow": ".github/workflows/prospect-signal-discovery.yml",
      "runtime": "python",
      "role": "bounded_official_site_hiring_and_technology_signal_discovery",
      "modes": ["validate", "discover"],
      "reads": ["ProspectCandidates", "ProspectSignals"],
      "writes": ["ProspectSignals"],
      "max_candidates_per_run": 25,
      "signal_types": ["hiring", "technology_wordpress", "technology_woocommerce"],
      "boundaries": ["discovered/qualified/hold candidates only", "official-site evidence only", "robots/pacing/timeout/byte limits retained", "no contact harvesting", "no Customer Potential mutation", "no qualification mutation", "no compliance mutation", "no mail copy", "no SMTP/IMAP credentials", "no send permission"]
    },
    "contact_enrichment": {
      "workflow": ".github/workflows/contact-enrichment.yml",
      "runtime": "python",
      "role": "bounded_official_site_business_email_discovery",
      "modes": ["validate", "discover"],
      "writes": ["ContactCandidates"],
      "boundaries": ["qualified ProspectCandidates only", "maximum 25 prospects per run", "maximum 3 contact-like pages per company", "no guessed or constructed email addresses", "no free-mail or no-reply addresses", "no mail credentials", "no send permission"]
    },
    "website_evidence_scan": {
      "workflow": ".github/workflows/scan.yml",
      "runtime": "node",
      "role": "optional_readonly_website_audit_capability",
      "read_only": true,
      "normal_default_for_every_prospect": false,
      "output": "scan-results/leads-handoff.json",
      "safe_boundary": "GET/HEAD only; no submit/order/payment/booking confirmation"
    },
    "sender_readiness": {
      "workflow": ".github/workflows/sender-readiness.yml",
      "runtime": "python",
      "role": "technical_sender_diagnostics",
      "writes": ["SenderReadiness"],
      "checks": ["SPF", "DKIM", "DMARC", "MX", "SMTP TLS", "IMAP TLS", "optional mailbox auth", "optional PTR/FCrDNS", "optional configured DNSBL zones"],
      "send_permission": "none"
    },
    "inbox_placement": {
      "workflow": ".github/workflows/inbox-placement.yml",
      "runtime": "python",
      "role": "manual_controlled_seed_placement_probe",
      "modes": ["validate", "test"],
      "manual_default": "validate",
      "writes": ["InboxPlacement"],
      "boundaries": ["workflow_dispatch only", "explicit confirmation required", "maximum 5 configured seed inboxes", "no OutreachQueue recipients", "no scheduled probes"]
    },
    "mailbox_draft": {
      "workflow": ".github/workflows/myhost-draft-test.yml",
      "runtime": "python",
      "role": "explicit_self_addressed_imap_draft_test",
      "modes": ["manual_confirmed", "one_time_push_request"],
      "writes": ["configured mijn.host Drafts/Concepten mailbox"],
      "send_permission": "none",
      "boundaries": ["IMAP APPEND only", "self-addressed test only", "no SMTP", "no Google Sheet access", "unique test-id readback required", "no schedule"]
    },
    "outreach_delivery": {
      "workflow": ".github/workflows/outreach-smtp.yml",
      "runtime": "python",
      "role": "controlled_transport_for_preapproved_evidence_bound_leads_state",
      "modes": ["validate", "live"],
      "manual_default": "validate",
      "transport": "direct mijn.host SMTP + IMAP readback",
      "external_email_verifier_required": false,
      "live_gate": "sender_readiness -> website target/evidence -> LeadPromo copy -> compliance -> SMTP",
      "boundaries": ["Leads owns qualification/contact/compliance/copy", "live sender readiness gate runs before target/evidence/copy/compliance/SMTP", "approved rows require website_scan JSON with same-domain evidence_url and exact idea present in body", "NL targets blocked by current policy", "official homepage is rechecked against agency/provider terms before SMTP", "US targets require configured physical postal address plus commercial-message identification", "UK unsolicited route requires verified corporate subscriber metadata and clear Ltd/Limited/LLP/PLC company form", "controlled English LeadPromo copy is allowed for international targets without mixing CTA/opt-out/signature languages", "compliance preflight runs before SMTP", "reply/bounce/opt-out stop sequences fail-closed", "suppression checked before send", "scheduled live requires explicit OUTREACH_ENABLED=true", "no live send from CI"]
    },
    "dashboard": {
      "surface": "Webactueel Leadlijst/Dashboard",
      "role": "readout_only_pipeline_and_deliverability_summary",
      "writes": [],
      "send_permission": "none"
    }
  },
  "scanner_routing": {
    "why_it_exists": "Levert reproduceerbaar desktop/mobile browserbewijs voor expliciete audits of een specifiek technisch bewijs-gat dat Leads na de lichte officiële-sitecheck heeft vastgesteld.",
    "use_when": ["de gebruiker expliciet een website-audit vraagt", "de gebruiker expliciet een technische scan of rescan vraagt", "Leads heeft een specifiek technisch bewijs-gat dat niet eenvoudiger bewezen kan worden"],
    "do_not_use_for": ["prospect discovery", "contactinformatie zoeken", "compliance bepalen", "leadscore bepalen", "mailcopy genereren", "SMTP/IMAP transport"]
  },
  "tools": {
    "crawlee": {"status":"existing","purpose":"bounded crawl orchestration","evidence_role":"orchestration_only"},
    "playwright": {"status":"existing","purpose":"desktop/mobile browser evidence","evidence_role":"primary_browser_evidence"},
    "axe_core": {"status":"enabled","purpose":"automated accessibility candidate signals","evidence_role":"supplemental_candidate_signal","automatic_score_effect":false},
    "sitemap_robots": {"status":"enabled","purpose":"route discovery and access policy","evidence_role":"route_discovery_support"},
    "linkinator": {"status":"enabled","purpose":"shallow same-origin link checks","evidence_role":"supplemental_candidate_signal"},
    "lighthouse": {"status":"existing_optional","purpose":"optional performance/accessibility/best-practices/SEO context","evidence_role":"supplemental_candidate_signal"},
    "languagetool": {"status":"optional_local","purpose":"optional Dutch language signals","evidence_role":"supplemental_candidate_signal"},
    "tech_detect": {"status":"enabled","purpose":"technology context for audit interpretation","evidence_role":"context_only"},
    "leads_handoff": {"status":"enabled","purpose":"normalize audit evidence for Leads readback","evidence_role":"handoff_adapter"},
    "prospect_discovery": {"status":"enabled","purpose":"bounded approved-source international company/domain discovery with target-fill, country/agency policy, observation provenance and historical source-run evidence","evidence_role":"lead_candidate_discovery"},
    "prospect_target_policy": {"status":"enabled","purpose":"exclude NL by default, prioritize US/non-NL European sources and add multilingual agency/provider exclusions","evidence_role":"discovery_target_policy","automatic_score_effect":false},
    "directory_sitemap_adapter": {"status":"enabled","purpose":"consume bounded public directory sitemap/urlset sources and follow same-host profile pages to official company domains","evidence_role":"source_mesh_adapter","automatic_score_effect":false},
    "prospect_intelligence": {"status":"enabled","purpose":"derive entity/freshness, source-performance, evidence-graph and lookalike views from evidence-bound Sheet state","evidence_role":"derived_prospect_intelligence","automatic_score_effect":false},
    "prospect_signal_discovery": {"status":"enabled","purpose":"collect bounded official-site hiring and WordPress/WooCommerce evidence for existing candidates","evidence_role":"advisory_signal_evidence","automatic_score_effect":false},
    "contact_enrichment": {"status":"enabled","purpose":"bounded official-site business-email lookup for qualified prospects","evidence_role":"contact_candidate_evidence"},
    "sender_readiness": {"status":"enabled","purpose":"technical sender authentication/connectivity/reputation diagnostics","evidence_role":"deliverability_diagnostics"},
    "inbox_placement": {"status":"manual_only","purpose":"controlled seed inbox/spam placement probe","evidence_role":"bounded_placement_sample"},
    "mailbox_draft": {"status":"manual_test_only","purpose":"append and verify one self-addressed concept through mijn.host IMAP","evidence_role":"mailbox_draft_readback"},
    "outreach_target_evidence": {"status":"enabled","purpose":"recheck approved targets, require same-domain website_scan evidence and enforce international target/compliance metadata before copy and SMTP","evidence_role":"pre_send_target_and_copy_provenance"},
    "outreach_transport": {"status":"enabled","purpose":"preflight, SMTP/IMAP, sequences, suppression and reporting","evidence_role":"transport_readback"},
    "dashboard": {"status":"enabled","purpose":"single Sheet control-panel readout","evidence_role":"aggregate_readout"}
  }
}
