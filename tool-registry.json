{
  "version": "3.9",
  "repository_role": "central_leads_github_runtime",
  "policy": {
    "website_scanner_read_only": true,
    "prospect_discovery_bounded": true,
    "prospect_target_policy_enforced": true,
    "prospect_source_semantics_enforced": true,
    "prospect_intelligence_advisory_only": true,
    "prospect_signal_discovery_advisory_only": true,
    "prospect_qualification_evidence_bound": true,
    "prospect_qualification_bounded": true,
    "contact_enrichment_qualified_only": true,
    "zero_touch_prepare_no_send": true,
    "sender_readiness_diagnostic_only": true,
    "inbox_placement_seed_only": true,
    "mailbox_draft_imap_only": true,
    "dashboard_readout_only": true,
    "outreach_live_fail_closed": true,
    "outreach_requires_evidence_bound_offer": true,
    "outreach_requires_website_scan_evidence": false,
    "agent_sales_default_offer_family": "ai_agent",
    "approved_agent_types": ["front_desk_sales", "lead_reactivation", "review_concierge", "customer_support", "commerce", "quote_intake"],
    "changes_lead_fit_automatically": true,
    "lead_fit_automation_scope": "bounded AgentProspectQualifications using evidence-bound agent opportunity scoring",
    "changes_compliance_automatically": false,
    "generates_mailcopy": true,
    "mailcopy_automation_scope": "deterministic agent-offer prepare rows for A-qualified and ContactCandidates.ready prospects; no inferred price",
    "prepared_copy_never_send_permission": true,
    "private_postal_config": true,
    "required_scanner_output": "scan-results/leads-handoff.json",
    "never_simulate_browser_evidence": true
  },
  "capabilities": {
    "prospect_discovery": {"workflow":".github/workflows/prospect-discovery.yml","runtime":"python","send_permission":"none"},
    "prospect_intelligence": {"workflow":".github/workflows/prospect-intelligence.yml","runtime":"python","send_permission":"none"},
    "prospect_signal_discovery": {"workflow":".github/workflows/prospect-signal-discovery.yml","runtime":"python","max_candidates_per_run":25,"send_permission":"none"},
    "prospect_qualification": {
      "workflow":".github/workflows/leads-autopilot.yml",
      "script":"scripts/prospect_agent_qualification.py",
      "runtime":"python",
      "role":"bounded_deterministic_ai_agent_customer_potential_qualification",
      "reads":["ProspectCandidates","ProspectSignals"],
      "writes":["ProspectCandidates","AgentProspectQualifications"],
      "max_candidates_per_run":25,
      "default_recheck_days":30,
      "offer_family":"ai_agent",
      "score_contract":"ICP 0-3 + agent opportunity 0-3 + active signal 0-2 + value/integration fit 0-2; A=8-10, B=6-7, C=0-5",
      "send_permission":"none"
    },
    "contact_enrichment": {"workflow":".github/workflows/contact-enrichment.yml","runtime":"python","input_boundary":"qualified ProspectCandidates only","send_permission":"none"},
    "zero_touch_prepare": {
      "workflow":".github/workflows/leads-autopilot.yml",
      "script":"scripts/outreach_agent_prepare.py",
      "runtime":"python",
      "role":"scheduled_bounded_ai_agent_discovery_qualification_contact_and_prepare_pipeline",
      "flow":"prospect_discovery -> prospect_candidate_sanitizer -> prospect_signal_discovery -> prospect_agent_qualification -> contact_enrichment -> prospect_intelligence -> private_outreach_config -> outreach_agent_prepare",
      "reads":["ProspectSources","ProspectCandidates","ProspectSignals","AgentProspectQualifications","ContactCandidates","Leadlijst","OutreachQueue","private Config Sheet"],
      "writes":["ProspectCandidates","AgentProspectQualifications","ContactCandidates","Leadlijst","OutreachQueue"],
      "send_permission":"none"
    },
    "website_evidence_scan": {"workflow":".github/workflows/scan.yml","runtime":"node","read_only":true,"normal_default_for_every_prospect":false,"output":"scan-results/leads-handoff.json"},
    "sender_readiness": {"workflow":".github/workflows/sender-readiness.yml","runtime":"python","send_permission":"none"},
    "inbox_placement": {"workflow":".github/workflows/inbox-placement.yml","runtime":"python","manual_default":"validate","send_permission":"configured_seed_test_only"},
    "mailbox_draft": {"workflow":".github/workflows/myhost-draft-test.yml","runtime":"python","send_permission":"none"},
    "outreach_delivery": {
      "workflow":".github/workflows/outreach-smtp.yml",
      "runtime":"python",
      "manual_default":"validate",
      "live_gate":"sender_readiness -> website target/evidence -> LeadPromo copy -> compliance -> SMTP",
      "evidence_sources":["agent_offer","website_scan_legacy"],
      "send_permission":"explicit_compliance_gated_live_only"
    },
    "dashboard": {"surface":"Webactueel Leadlijst/Dashboard","role":"readout_only_pipeline_and_deliverability_summary","send_permission":"none"}
  },
  "tools": {
    "crawlee": {"status":"existing","automatic_score_effect":false},
    "playwright": {"status":"existing","automatic_score_effect":false},
    "axe_core": {"status":"enabled","automatic_score_effect":false},
    "sitemap_robots": {"status":"enabled","automatic_score_effect":false},
    "linkinator": {"status":"enabled","automatic_score_effect":false},
    "lighthouse": {"status":"existing_optional","automatic_score_effect":false},
    "languagetool": {"status":"optional_local","automatic_score_effect":false},
    "tech_detect": {"status":"enabled","automatic_score_effect":false},
    "leads_handoff": {"status":"enabled","automatic_score_effect":false},
    "prospect_agent_qualification": {"status":"enabled","automatic_score_effect":true},
    "outreach_agent_prepare": {"status":"enabled","send_permission":"none"},
    "outreach_target_evidence": {"status":"enabled","accepted_sources":["agent_offer","website_scan_legacy"]},
    "outreach_transport": {"status":"enabled","send_permission":"gated"}
  }
}