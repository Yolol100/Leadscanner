{
  "version": "4.0",
  "repository_role": "central_leads_github_runtime",
  "policy": {
    "website_scanner_read_only": true,
    "full_website_scan_default": false,
    "prospect_discovery_bounded": true,
    "prospect_qualification_evidence_bound": true,
    "campaign_first_agent_sales": true,
    "campaign_prepare_requires_explicit_agent_type": true,
    "campaign_gate_canonical_state_mutation": false,
    "campaign_contact_enrichment_match_only": true,
    "value_asset_before_contact": true,
    "default_agent_outreach_has_generic_cases_url": false,
    "zero_touch_prepare_no_send": true,
    "outreach_live_fail_closed": true,
    "agent_sales_default_offer_family": "ai_agent",
    "approved_agent_types": ["front_desk_sales","lead_reactivation","review_concierge","customer_support","commerce","quote_intake"],
    "changes_lead_fit_automatically": true,
    "changes_compliance_automatically": false,
    "generates_mailcopy": true,
    "prepared_copy_never_send_permission": true,
    "private_postal_config": true,
    "never_simulate_browser_evidence": true
  },
  "capabilities": {
    "prospect_discovery": {"workflow":".github/workflows/prospect-discovery.yml","runtime":"python","role":"bounded_company_domain_discovery","writes":["ProspectCandidates","ProspectObservations","ProspectSourceRuns"],"send_permission":"none"},
    "prospect_intelligence": {"workflow":".github/workflows/prospect-intelligence.yml","runtime":"python","role":"advisory_entity_source_signal_intelligence","send_permission":"none"},
    "prospect_signal_discovery": {"workflow":".github/workflows/prospect-signal-discovery.yml","runtime":"python","role":"bounded_official_site_signal_discovery","send_permission":"none"},
    "prospect_qualification": {"workflow":".github/workflows/leads-autopilot.yml","script":"scripts/prospect_agent_qualification.py","runtime":"python","role":"bounded_evidence_bound_ai_agent_customer_potential_qualification","writes":["ProspectCandidates","AgentProspectQualifications"],"offer_family":"ai_agent","score_contract":"ICP 0-3 + agent opportunity 0-3 + active signal 0-2 + value/integration fit 0-2; A=8-10, B=6-7, C=0-5","send_permission":"none"},
    "campaign_gate": {"workflow":".github/workflows/leads-autopilot.yml","script":"scripts/prospect_campaign_gate.py","runtime":"python","role":"read_only_explicit_agent_campaign_match_audit","modes":["validate","audit"],"canonical_candidate_state_mutated":false,"send_permission":"none"},
    "contact_enrichment": {"workflow":".github/workflows/contact-enrichment.yml","legacy_script":"scripts/prospect_contact_enrichment.py","campaign_script":"scripts/prospect_contact_enrichment_campaign.py","runtime":"python","role":"bounded_official_site_business_email_discovery","input_boundary":"campaign-matching A-qualified prospects for campaign prepare; standalone legacy qualified-only workflow retained","writes":["ContactCandidates"],"send_permission":"none"},
    "zero_touch_prepare": {"workflow":".github/workflows/leads-autopilot.yml","script":"scripts/outreach_agent_prepare_v2.py","legacy_script":"scripts/outreach_agent_prepare.py","runtime":"python","role":"campaign_first_bounded_agent_discovery_qualification_contact_value_flow_prepare_pipeline","flow":"prospect_discovery -> prospect_candidate_sanitizer -> prospect_signal_discovery -> prospect_agent_qualification -> prospect_campaign_gate -> prospect_contact_enrichment_campaign -> prospect_intelligence -> private_outreach_config -> outreach_agent_prepare_v2","campaign_target_contract":"explicit approved agent type required for prepare; auto validate/exploration only","value_asset_contract":"process_flow concept_ready value_asset_summary before contact/copy","writes":["ProspectCandidates","ProspectObservations","ProspectSourceRuns","ProspectSignals","AgentProspectQualifications","ContactCandidates","ProspectEntities","ProspectSourceMetrics","ProspectEvidence","ProspectLookalikes","Leadlijst","OutreachQueue"],"send_permission":"none"},
    "website_evidence_scan": {"workflow":".github/workflows/scan.yml","runtime":"node","read_only":true,"normal_default_for_every_prospect":false,"output":"scan-results/leads-handoff.json"},
    "sender_readiness": {"workflow":".github/workflows/sender-readiness.yml","runtime":"python","send_permission":"none"},
    "inbox_placement": {"workflow":".github/workflows/inbox-placement.yml","runtime":"python","manual_default":"validate","send_permission":"configured_seed_test_only"},
    "mailbox_draft": {"workflow":".github/workflows/myhost-draft-test.yml","runtime":"python","send_permission":"none"},
    "outreach_delivery": {"workflow":".github/workflows/outreach-smtp.yml","runtime":"python","manual_default":"validate","live_gate":"sender_readiness -> website target/evidence -> LeadPromo copy -> compliance -> SMTP","evidence_sources":["agent_offer","website_scan_legacy"],"send_permission":"explicit_compliance_gated_live_only"},
    "dashboard": {"surface":"Webactueel Leadlijst/Dashboard","role":"readout_only_pipeline_and_deliverability_summary","send_permission":"none"}
  },
  "tools": {
    "crawlee":{"status":"existing","automatic_score_effect":false},
    "playwright":{"status":"existing","automatic_score_effect":false},
    "axe_core":{"status":"enabled","automatic_score_effect":false},
    "sitemap_robots":{"status":"enabled","automatic_score_effect":false},
    "directory_sitemap_adapter":{"status":"enabled","automatic_score_effect":false},
    "linkinator":{"status":"enabled","automatic_score_effect":false},
    "lighthouse":{"status":"existing_optional","automatic_score_effect":false},
    "languagetool":{"status":"optional_local","automatic_score_effect":false},
    "tech_detect":{"status":"enabled","automatic_score_effect":false},
    "leads_handoff":{"status":"enabled","automatic_score_effect":false},
    "prospect_intelligence":{"status":"enabled","automatic_score_effect":false},
    "prospect_agent_qualification":{"status":"enabled","automatic_score_effect":true},
    "prospect_campaign_gate":{"status":"enabled","automatic_score_effect":false,"canonical_candidate_state_mutated":false,"send_permission":"none"},
    "prospect_contact_enrichment_campaign":{"status":"enabled","automatic_score_effect":false,"send_permission":"none"},
    "outreach_agent_prepare":{"status":"legacy_compatibility","send_permission":"none"},
    "outreach_agent_prepare_v2":{"status":"enabled","default_for_campaign_prepare":true,"send_permission":"none"},
    "outreach_target_evidence":{"status":"enabled","accepted_sources":["agent_offer","website_scan_legacy"]},
    "outreach_transport":{"status":"enabled","send_permission":"gated"}
  }
}
