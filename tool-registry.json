{
  "version": "2.3",
  "repository_role": "optional_readonly_website_audit_capability",
  "policy": {
    "read_only": true,
    "normal_starteractie_route": false,
    "changes_lead_fit_automatically": false,
    "changes_outreach_status_automatically": false,
    "required_output": "scan-results/leads-handoff.json",
    "fallback_when_runtime_unavailable": "handoff_required",
    "never_simulate_browser_evidence": true
  },
  "routing": {
    "why_this_repository_exists": "Levert reproduceerbaar desktop/mobile browserbewijs wanneer de gebruiker expliciet om een website-audit, technische scan of rescan vraagt.",
    "use_repository_when": [
      "de gebruiker expliciet een website-audit vraagt",
      "de gebruiker expliciet een technische scan vraagt",
      "de gebruiker expliciet een rescan van een bevestigde officiële bedrijfswebsite vraagt"
    ],
    "do_not_use_repository_when": [
      "bedrijven of websites vinden",
      "Registry-deduplicatie",
      "officiële bedrijfsbevestiging zonder audit",
      "contactinformatie of e-mailadres zoeken",
      "verzendgrond controleren",
      "leadlijst bouwen",
      "mailcopy of Gmail/Outlook-concepten maken",
      "leadgeschiktheid, Leadscore of prioriteit bepalen",
      "follow-upstatus beheren"
    ],
    "preconditions": [
      "de officiële bedrijfswebsite is bevestigd",
      "de gebruiker heeft de audit of scan expliciet gevraagd",
      "de actuele surface heeft een bewezen GitHub Actions- of lokale repo-uitvoerroute"
    ],
    "required_inputs": [
      "exact één publieke officiële bedrijfswebsite via requests/scan.json target_url of workflow_dispatch target_url",
      "sites.txt alleen voor expliciet handmatige lokale batchinput"
    ],
    "execution_modes": {
      "github_actions": {
        "workflow": ".github/workflows/scan.yml",
        "primary_input": "target_url",
        "request_file": "requests/scan.json",
        "sites_txt_trigger": false,
        "post_scan_command": "npm run handoff:leads"
      },
      "codex_or_cli_local": {
        "commands": [
          "npm ci",
          "npx playwright install chromium --with-deps",
          "npm run scan",
          "npm run enrich",
          "npm run handoff:leads"
        ]
      },
      "unavailable": {
        "result": "handoff_required"
      }
    },
    "default_limits": {
      "max_concurrency": 2,
      "max_requests_per_minute": 30,
      "max_pages_per_site": 4,
      "safe_boundary": "GET/HEAD only; no submit/order/payment/booking confirmation"
    },
    "expected_output": {
      "file": "scan-results/leads-handoff.json",
      "format": "webactueel-leadscanner-handoff/1.1",
      "runtime_surface": "controlled-browser",
      "contains": [
        "desktop/mobile browser evidence",
        "page evidence",
        "finding candidates",
        "supplemental audit signals"
      ]
    },
    "after_execution": [
      "validate artifact provenance/readback",
      "report only evidence-backed audit observations",
      "do not change fit, priority, send permission or outreach state automatically"
    ]
  },
  "tools": {
    "crawlee": {"status":"existing","purpose":"bounded crawl orchestration","evidence_role":"orchestration_only"},
    "playwright": {"status":"existing","purpose":"desktop/mobile browser evidence","evidence_role":"primary_browser_evidence"},
    "axe_core": {"status":"enabled","purpose":"automated accessibility candidate signals","evidence_role":"supplemental_candidate_signal"},
    "sitemap_robots": {"status":"enabled","purpose":"route discovery and access policy","evidence_role":"route_discovery_support"},
    "linkinator": {"status":"enabled","purpose":"shallow same-origin link checks","evidence_role":"supplemental_candidate_signal"},
    "lighthouse": {"status":"existing_optional","purpose":"optional performance/accessibility/best-practices/SEO context","evidence_role":"supplemental_candidate_signal"},
    "languagetool": {"status":"optional_local","purpose":"optional Dutch language signals","evidence_role":"supplemental_candidate_signal"},
    "tech_detect": {"status":"enabled","purpose":"technology context for audit interpretation","evidence_role":"context_only"},
    "leads_handoff": {"status":"enabled","purpose":"normalize audit evidence for readback","evidence_role":"handoff_adapter"}
  }
}
