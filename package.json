{
  "name": "webactueel-leadscanner",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "scan": "node src/scan.mjs",
    "enrich": "node src/enrich.mjs",
    "handoff:leads": "node src/leads-handoff.mjs",
    "smoke:toolbox": "node src/toolbox-smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "check:crawler": "node -e \"Promise.all([import('crawlee'), import('playwright')]).then(() => console.log('Crawlee + Playwright OK'))\"",
    "check:tools": "node -e \"Promise.all([import('linkinator'), import('lighthouse')]).then(() => console.log('Linkinator + Lighthouse OK'))\""
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "crawlee": "3.18.0",
    "lighthouse": "13.4.1",
    "linkinator": "8.0.4",
    "playwright": "1.62.1"
  }
}
